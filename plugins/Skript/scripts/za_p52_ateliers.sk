# =====================================================================
#  ZombieApocalypse - ATELIERS SPÉCIALISÉS (#13) : cinq postes de travail à construire dans sa base
#  Un atelier = un bloc que le joueur pose lui-même dans sa base (rayon 40 de /base definir) puis « active » avec /atelier creer <type>
#  en le regardant :  médical = alambic (brewing stand) · militaire = table de forgeron (smithing table) · mécanique = enclume ·
#  laboratoire = chaudron · électronique = métier à tisser (loom).  Coût : jetons + matériaux.  Niveaux 1 à 3 (/atelier ameliorer) ;
#  les niveaux 2 et 3 demandent la ressource stratégique de la saison ({za::ressource::nom}, sinon « Composant electronique »).
#  Clic droit sur le bloc = menu des recettes (za_menu) ; accroupi = interface normale du bloc.  Une entrée grisée dit pourquoi
#  (niveau, courant ou matériaux manquants).  Le niveau donne aussi -10 %% de jetons par niveau au-dessus de 1.
#  Courant : certaines recettes exigent une génératrice qui tourne à moins de 24 blocs (za_p14) ou le quartier résidentiel branché
#  ({za::reseau::residentiel}).  Une impulsion EMP coupe tout.
#  Médical      : Bandage, Attelle, Antibiotique (-50 %% si {za::reseau::hopital}), Sérum avancé (niv 3, guérit à tout stade),
#                 Soins de l'atelier (zablessure soigner + plaies)
#  Militaire    : munitions TaCZ (poudre + pépites de fer/Ferraille), chargeurs, poignée, optiques, lasers, silencieux, munitions spéciales
#                 (zaarme accessoire).  Soldat : +25 %% de munitions.
#  Mécanique    : réparer l'arme en main (zaarme reparer, remise selon niveau et courant), réparer outil/armure, Pied-de-biche, Jerrican,
#                 blinder une porte (za_p23, 15/15), Générateur.  Ingénieur : -30 %% de jetons.
#  Laboratoire  : analyse de souche, Antidote, Vaccin expérimental (20 min d'immunité à l'infection, niv 3), Notes de recherche
#                 (déchiffrer des « Note de recherche » = 12 notes de lore).
#  Électronique : Radio portable (balayage des fréquences), Alarme de périmètre (avertit le propriétaire quand des morts approchent),
#                 Capteur de présence (avertit quand un inconnu entre dans la base).  Rayons d'alarme/capteur selon le niveau.
#  Commandes joueur : /atelier  /atelier creer <type>|ameliorer|recettes [type]|deplacer <type>|supprimer <type>|aide
#  Admin/console    : /zatelier <etat|liste|poser|niveau|retirer|materiel|vaccin|courant|ouvrir|nettoyer>
#  Variables publiées : {za::at::liste::*} (clés « x_y_z_monde »), {za::at::<clé>::type|niveau|proprio|loc},
#    {za::at::niv::<uuid>::<type>} (niveau, absent = pas d'atelier), {za::at::cle::<uuid>::<type>}, {za::vaccin::fin::<uuid>} (date)
#  Fonctions publiées : za_atelier_niveau(uuid, type) -> 0..3 · za_vaccin_actif(joueur) -> booléen · za_at_courant(lieu) -> booléen
#  Stat : ateliers (+1 par fabrication réussie)
# =====================================================================

options:
    rayon_base: 40
    rayon_usage: 9
    max_alarmes: 3
    max_capteurs: 3
    duree_vaccin: 20 minutes

# ---------------------------------------------------------------- types d'ateliers

function za_at_types() :: texts:
    return "medical", "militaire", "mecanique", "laboratoire" and "electronique"

# reconnaît « médical », « mil », « méc », « labo », « élec »...
function za_at_norm(t: text) :: text:
    set {_s} to {_t} in lowercase
    if {_s} contains "mil":
        return "militaire"
    if {_s} contains "med":
        return "medical"
    if {_s} contains "méd":
        return "medical"
    if {_s} contains "mec":
        return "mecanique"
    if {_s} contains "méc":
        return "mecanique"
    if {_s} contains "lab":
        return "laboratoire"
    if {_s} contains "elec":
        return "electronique"
    if {_s} contains "élec":
        return "electronique"
    return ""

function za_at_nom(t: text) :: text:
    if {_t} is "medical":
        return "Atelier médical"
    if {_t} is "militaire":
        return "Atelier militaire"
    if {_t} is "mecanique":
        return "Atelier mécanique"
    if {_t} is "laboratoire":
        return "Laboratoire"
    if {_t} is "electronique":
        return "Atelier électronique"
    return {_t}

function za_at_col(t: text) :: text:
    if {_t} is "medical":
        return "&c"
    if {_t} is "militaire":
        return "&2"
    if {_t} is "mecanique":
        return "&6"
    if {_t} is "laboratoire":
        return "&5"
    return "&b"

# nom français du bloc à poser
function za_at_bloc_nom(t: text) :: text:
    if {_t} is "medical":
        return "alambic (brewing stand)"
    if {_t} is "militaire":
        return "table de forgeron (smithing table)"
    if {_t} is "mecanique":
        return "enclume (anvil)"
    if {_t} is "laboratoire":
        return "chaudron (cauldron)"
    return "métier à tisser (loom)"

function za_at_bloc_ok(t: text, b: block) :: boolean:
    set {_ty} to "%type of {_b}%"
    if {_t} is "medical":
        if {_ty} contains "brewing stand":
            return true
    else if {_t} is "militaire":
        if {_ty} contains "smithing table":
            return true
    else if {_t} is "mecanique":
        if {_ty} contains "anvil":
            return true
    else if {_t} is "laboratoire":
        if {_ty} contains "cauldron":
            return true
    else if {_t} is "electronique":
        if {_ty} contains "loom":
            return true
    return false

function za_at_ambiance(t: text) :: text:
    if {_t} is "medical":
        return "Table de soins, gaze et bocaux. Ici on fabrique de quoi tenir jusqu'au matin."
    if {_t} is "militaire":
        return "Établi de munitionnaire : poudre, plomb et pièces détachées. Ça sent l'huile et la peur."
    if {_t} is "mecanique":
        return "Enclume, étau, huile noire. Tout ce qui est tordu finit par se redresser."
    if {_t} is "laboratoire":
        return "Fioles, buée, odeur d'éther. Le virus se laisse lire par ceux qui savent regarder."
    return "Fer à souder, piles, fil de cuivre. Chaque grésillement peut sauver une base."

# ---------------------------------------------------------------- ressource de saison, courant, joueurs

# durée lisible : "2 j 5 h" / "3 h 12 min" / "45 min"
function za_at_duree(ts: timespan) :: text:
    set {_s} to floor({_ts} / 1 second)
    if {_s} < 60:
        return "moins d'une minute"
    set {_j} to floor({_s} / 86400)
    set {_h} to floor(({_s} - ({_j} * 86400)) / 3600)
    set {_m} to floor(({_s} - ({_j} * 86400) - ({_h} * 3600)) / 60)
    if {_j} > 0:
        return "%{_j}% j %{_h}% h"
    if {_h} > 0:
        return "%{_h}% h %{_m}% min"
    return "%{_m}% min"

function za_at_res() :: text:
    if {za::ressource::nom} is set:
        return "%{za::ressource::nom}%"
    return "Composant electronique"

# courant à cet endroit : réseau résidentiel branché, ou génératrice qui tourne à moins de 24 blocs. Une impulsion EMP coupe tout.
function za_at_courant(l: location) :: boolean:
    if za_emp_actif() is true:
        return false
    if {za::reseau::residentiel} is true:
        return true
    loop {za::gen::liste::*}:
        set {_g} to {za::gen::%loop-value%::loc}
        if {_g} is set:
            if world of {_g} is world of {_l}:
                if distance between {_g} and {_l} <= 24:
                    if {za::gen::%loop-value%::fin} is set:
                        if now is less than {za::gen::%loop-value%::fin}:
                            return true
    return false

function za_at_courant_txt(l: location) :: text:
    if za_emp_actif() is true:
        return "&cImpulsion EMP : tout est coupé"
    if {za::reseau::residentiel} is true:
        return "&aoui &7(quartier résidentiel branché)"
    if za_at_courant({_l}) is true:
        return "&aoui &7(génératrice)"
    return "&cnon &7(génératrice en marche à moins de 24 blocs, ou quartier résidentiel branché)"

function za_at_joueur(u: text) :: player:
    loop all players:
        if loop-player's uuid is {_u}:
            return loop-player

# même équipe (squad) : ne déclenche pas les capteurs
function za_at_ami(a: text, b: text) :: boolean:
    if {_a} is {_b}:
        return true
    if {za::squad::id::%{_a}%} is set:
        if {za::squad::id::%{_a}%} is {za::squad::id::%{_b}%}:
            return true
    return false

# position de l'entité la plus proche d'un lieu (le lieu lui-même si la liste est vide)
function za_at_proche(l: location, es: entities) :: location:
    set {_best} to 99999
    set {_res} to {_l}
    loop {_es::*}:
        set {_d} to distance between loop-value and {_l}
        if {_d} < {_best}:
            set {_best} to {_d}
            set {_res} to location of loop-value
    return {_res}

function za_at_dir(de: location, vers: location) :: text:
    set {_dx} to x-coordinate of {_vers} - x-coordinate of {_de}
    set {_dz} to z-coordinate of {_vers} - z-coordinate of {_de}
    set {_a} to atan2({_dx}, {_dz})
    if {_a} < 0:
        add 360 to {_a}
    # 0 = est, 90 = sud, 180 = ouest, 270 = nord
    if {_a} >= 337.5:
        return "l'est"
    if {_a} >= 292.5:
        return "le nord-est"
    if {_a} >= 247.5:
        return "le nord"
    if {_a} >= 202.5:
        return "le nord-ouest"
    if {_a} >= 157.5:
        return "l'ouest"
    if {_a} >= 112.5:
        return "le sud-ouest"
    if {_a} >= 67.5:
        return "le sud"
    if {_a} >= 22.5:
        return "le sud-est"
    return "l'est"

# ---------------------------------------------------------------- registre des ateliers

function za_atelier_niveau(u: text, t: text) :: number:
    set {_n} to {za::at::niv::%{_u}%::%{_t}%}
    if {_n} is not set:
        return 0
    return {_n}

function za_at_cle(u: text, t: text) :: text:
    set {_k} to {za::at::cle::%{_u}%::%{_t}%}
    if {_k} is not set:
        return ""
    return "%{_k}%"

function za_at_enregistrer(k: text, t: text, u: text, l: location, niv: number):
    set {za::at::%{_k}%::type} to {_t}
    set {za::at::%{_k}%::niveau} to {_niv}
    set {za::at::%{_k}%::proprio} to {_u}
    set {za::at::%{_k}%::loc} to {_l}
    set {za::at::niv::%{_u}%::%{_t}%} to {_niv}
    set {za::at::cle::%{_u}%::%{_t}%} to {_k}
    if {za::at::liste::*} does not contain {_k}:
        add {_k} to {za::at::liste::*}

# retire un atelier du registre ; garde son niveau pour une reconstruction (voir /atelier creer)
function za_at_retirer(k: text, garder: boolean):
    set {_t} to {za::at::%{_k}%::type}
    set {_u} to {za::at::%{_k}%::proprio}
    if {_t} is set:
        if {_u} is set:
            if {_garder} is true:
                set {za::at::reste::%{_u}%::%{_t}%} to {za::at::%{_k}%::niveau}
            if {za::at::cle::%{_u}%::%{_t}%} is {_k}:
                delete {za::at::cle::%{_u}%::%{_t}%}
                delete {za::at::niv::%{_u}%::%{_t}%}
    remove {_k} from {za::at::liste::*}
    delete {za::at::%{_k}%::*}

function za_at_niveau_cle(k: text) :: number:
    set {_n} to {za::at::%{_k}%::niveau}
    if {_n} is not set:
        return 0
    return {_n}

# ---------------------------------------------------------------- ingrédients

# nom français d'un matériau vanille
function za_at_fr(t: text) :: text:
    if {_t} is "paper":
        return "papier"
    if {_t} is "string":
        return "ficelle"
    if {_t} is "stick":
        return "bâton"
    if {_t} is "iron ingot":
        return "lingot de fer"
    if {_t} is "gold ingot":
        return "lingot d'or"
    if {_t} is "copper ingot":
        return "lingot de cuivre"
    if {_t} is "glass bottle":
        return "fiole vide"
    if {_t} is "honey bottle":
        return "bouteille de miel"
    if {_t} is "honeycomb":
        return "rayon de miel"
    if {_t} is "gunpowder":
        return "poudre à canon"
    if {_t} is "iron nugget":
        return "pépite de fer"
    if {_t} is "redstone":
        return "redstone"
    if {_t} is "blast furnace":
        return "haut fourneau"
    if {_t} is "bucket":
        return "seau"
    return {_t}

# nom affiché d'une variante d'ingrédient (« ~paper/Ferraille » -> « papier ou Ferraille »)
function za_at_nom_spec(spec: text) :: text:
    set {_r::*} to split {_spec} at "/"
    loop {_r::*}:
        set {_v} to loop-value
        if {_v} starts with "~":
            set {_v} to za_at_fr(subtext of {_v} from characters 2 to length of {_v})
        add {_v} to {_o::*}
    return join {_o::*} with " ou "

# un objet correspond-il à une variante ? « ~type » = objet vanille SANS nom ; sinon nom exact (sans couleur)
function za_at_match(it: itemtype, v: text) :: boolean:
    if {_v} starts with "~":
        if name of {_it} is set:
            return false
        set {_ty} to (subtext of {_v} from characters 2 to length of {_v}) parsed as itemtype
        if {_it} is {_ty}:
            return true
        return false
    if uncolored name of {_it} is {_v}:
        return true
    return false

function za_at_compte_v(p: player, v: text) :: number:
    set {_c} to 0
    set {_i} to 0
    while {_i} < 36:
        set {_it} to slot {_i} of inventory of {_p}
        if {_it} is not air:
            if za_at_match({_it}, {_v}) is true:
                add item amount of {_it} to {_c}
        add 1 to {_i}
    return {_c}

# total d'un ingrédient (toutes les variantes « a/b » cumulées)
function za_at_compte(p: player, spec: text) :: number:
    set {_vs::*} to split {_spec} at "/"
    set {_t} to 0
    loop {_vs::*}:
        add za_at_compte_v({_p}, loop-value) to {_t}
    return {_t}

function za_at_prendre_v(p: player, v: text, n: number) :: number:
    set {_left} to {_n}
    set {_i} to 0
    while {_i} < 36:
        if {_left} > 0:
            set {_it} to slot {_i} of inventory of {_p}
            if {_it} is not air:
                if za_at_match({_it}, {_v}) is true:
                    set {_a} to item amount of {_it}
                    if {_a} <= {_left}:
                        remove {_a} from {_left}
                        set slot {_i} of inventory of {_p} to air
                    else:
                        set {_neuf} to ({_a} - {_left}) of {_it}
                        set {_left} to 0
                        set slot {_i} of inventory of {_p} to {_neuf}
        add 1 to {_i}
    return {_n} - {_left}

function za_at_prendre(p: player, spec: text, n: number):
    set {_vs::*} to split {_spec} at "/"
    set {_left} to {_n}
    loop {_vs::*}:
        if {_left} > 0:
            set {_got} to za_at_prendre_v({_p}, loop-value, {_left})
            remove {_got} from {_left}

# résout $RES (ressource de saison) et fusionne les doublons : « a@1;b@2;a@2 » -> « a@3;b@2 »
function za_at_ing(ing: text) :: text:
    if {_ing} is "-":
        return ""
    if {_ing} is "":
        return ""
    replace all "$RES" with za_at_res() in {_ing}
    set {_a::*} to split {_ing} at ";"
    loop {_a::*}:
        set {_e::*} to split loop-value at "@"
        set {_q} to {_e::2} parsed as number
        if {_m::%{_e::1}%} is not set:
            set {_m::%{_e::1}%} to 0
            add {_e::1} to {_ordre::*}
        add {_q} to {_m::%{_e::1}%}
    loop {_ordre::*}:
        add "%loop-value%@%{_m::%loop-value%}%" to {_o::*}
    return join {_o::*} with ";"

# ce qui manque au joueur (texte), "" si tout est là
function za_at_manque(p: player, ing: text, j: number) :: text:
    if {_ing} is not "":
        set {_a::*} to split {_ing} at ";"
        loop {_a::*}:
            set {_e::*} to split loop-value at "@"
            set {_q} to {_e::2} parsed as number
            set {_c} to za_at_compte({_p}, {_e::1})
            if {_c} < {_q}:
                add "%za_at_nom_spec({_e::1})% x%{_q} - {_c}%" to {_m::*}
    if {_j} > za_jetons({_p}):
        add "%{_j} - za_jetons({_p})% jetons" to {_m::*}
    if size of {_m::*} is 0:
        return ""
    return join {_m::*} with ", "

function za_at_prendre_ing(p: player, ing: text):
    if {_ing} is not "":
        set {_a::*} to split {_ing} at ";"
        loop {_a::*}:
            set {_e::*} to split loop-value at "@"
            za_at_prendre({_p}, {_e::1}, {_e::2} parsed as number)

function za_at_cout_txt(ing: text, j: number) :: text:
    if {_ing} is not "":
        set {_a::*} to split {_ing} at ";"
        loop {_a::*}:
            set {_e::*} to split loop-value at "@"
            add "%za_at_nom_spec({_e::1})% x%{_e::2}%" to {_o::*}
    if {_j} > 0:
        add "%{_j}% jetons" to {_o::*}
    if size of {_o::*} is 0:
        return "gratuit"
    return join {_o::*} with ", "

# ---------------------------------------------------------------- coût de construction / amélioration : "jetons|ingrédients"

function za_at_cout_niv(t: text, n: number) :: text:
    if {_t} is "medical":
        if {_n} is 1:
            return "30|~iron ingot@4;~paper@6;~glass bottle@2"
        if {_n} is 2:
            return "60|~iron ingot@6;~paper@8;$RES@1"
        return "110|~iron ingot@8;~gold ingot@4;$RES@3"
    if {_t} is "militaire":
        if {_n} is 1:
            return "40|~iron ingot@8;Ferraille@4"
        if {_n} is 2:
            return "70|~iron ingot@10;Ferraille@6;$RES@1"
        return "130|~iron ingot@14;Ferraille@10;$RES@3"
    if {_t} is "mecanique":
        if {_n} is 1:
            return "25|~iron ingot@6;Ferraille@3"
        if {_n} is 2:
            return "55|~iron ingot@8;Ferraille@5;$RES@1"
        return "100|~iron ingot@12;Ferraille@8;$RES@3"
    if {_t} is "laboratoire":
        if {_n} is 1:
            return "45|~glass bottle@6;~iron ingot@4;Sang infecte@2"
        if {_n} is 2:
            return "80|~glass bottle@6;~gold ingot@3;$RES@1"
        return "140|~glass bottle@8;~gold ingot@5;$RES@3"
    if {_n} is 1:
        return "50|~redstone@4;~iron ingot@4;Composant electronique@2"
    if {_n} is 2:
        return "85|~redstone@8;~copper ingot/~iron ingot@4;Composant electronique@3;$RES@1"
    return "140|~redstone@12;~copper ingot/~iron ingot@6;Composant electronique@4;$RES@3"

function za_at_cout_jetons(p: player, t: text, n: number) :: number:
    set {_c::*} to split za_at_cout_niv({_t}, {_n}) at "|"
    return za_prix({_p}, {_c::1} parsed as number)

function za_at_cout_ing(t: text, n: number) :: text:
    set {_c::*} to split za_at_cout_niv({_t}, {_n}) at "|"
    return za_at_ing({_c::2})

# ---------------------------------------------------------------- recettes
#  ligne = type|catégorie|niveau|jetons|courant(0/1)|nom affiché|ingrédients|action
#  ingrédients : « spec@qté;spec@qté » ; spec = « ~matériau vanille » ou « Nom exact » ; « a/b » = l'un ou l'autre ; $RES = ressource de saison
#  action : item#matériau#Nom#couleur#qté · ammo#id#qté · acc#id · ou une action spéciale

function za_at_def(id: text, ligne: text):
    set {za::atdef::%{_id}%} to {_ligne}
    add {_id} to {za::atdef_ids::*}

on load:
    delete {za::atdef::*}
    delete {za::atdef_ids::*}
    # --- médical
    za_at_def("bandage", "medical|-|1|2|0|Bandage x3|~paper@3;~string@2|item#paper#Bandage#&f#3")
    za_at_def("attelle", "medical|-|1|2|0|Attelle x2|~stick@2;~paper@1;~string@1|item#stick#Attelle#&f#2")
    za_at_def("antibio", "medical|-|2|10|0|Antibiotique x2|Sang infecte/Échantillon viral@1;~honey bottle/~honeycomb@1|item#honey bottle#Antibiotique#&b#2")
    za_at_def("soins", "medical|-|2|8|1|Soins de l'atelier|Bandage@2|soins")
    za_at_def("serum2", "medical|-|3|40|1|Sérum avancé|Serum@2;Échantillon viral@1|serum2")
    # --- mécanique
    za_at_def("rep_arme", "mecanique|-|1|0|0|Réparer l'arme en main|-|reparer_arme")
    za_at_def("rep_outil", "mecanique|-|1|3|0|Réparer l'outil ou l'armure en main|~iron ingot@1|reparer_outil")
    za_at_def("pied", "mecanique|-|1|3|0|Pied-de-biche|~iron ingot@2;Ferraille@1|item#iron ingot#Pied-de-biche#&7#1")
    za_at_def("jerrican", "mecanique|-|1|4|0|Jerrican|~iron ingot@3|item#bucket#Jerrican#&e#1")
    za_at_def("porte", "mecanique|-|2|4|0|Blinder la porte visée (15/15)|~iron ingot@4;Ferraille@2|porte")
    za_at_def("generateur", "mecanique|-|2|12|0|Générateur|~blast furnace@1;Pieces de generateur/~iron ingot@2;Composant electronique@1|item#blast furnace#Generateur#&e#1")
    # --- laboratoire
