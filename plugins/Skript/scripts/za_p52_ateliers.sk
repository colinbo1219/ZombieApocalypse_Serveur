    za_at_def("okp7", "militaire|opt|1|12|0|Viseur point rouge OKP-7|Composant electronique@1;~iron ingot@1|acc#sight_okp7")
    za_at_def("exp3", "militaire|opt|1|12|0|Viseur holographique EXP-3|Composant electronique@1;~iron ingot@1|acc#sight_exp3")
