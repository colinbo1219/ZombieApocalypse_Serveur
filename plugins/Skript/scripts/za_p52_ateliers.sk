    # --- militaire : chargeurs et poignée
    za_at_def("xmag1", "militaire|cha|1|10|0|Chargeur étendu I|~iron ingot@2;Ferraille@2|acc#extended_mag_1")
    za_at_def("xmag2", "militaire|cha|2|18|0|Chargeur étendu II|~iron ingot@3;Ferraille@4|acc#extended_mag_2")
    za_at_def("xmag3", "militaire|cha|3|30|0|Chargeur étendu III|~iron ingot@4;Ferraille@6;$RES@1|acc#extended_mag_3")
