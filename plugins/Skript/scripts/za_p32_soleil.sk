# =====================================================================
#  ZombieApocalypse - AUCUN MONSTRE NE BRULE AU SOLEIL (zombies vanilla, noyes, squelettes compris)
#  Les zombies MythicMobs ont deja PreventSunburn. Ici on couvre aussi les zombies vanilla (noyes, zombies-villageois, etc.) :
#  quand l'evenement de combustion arrive en plein jour, a ciel ouvert, sans lave ni feu sous les pieds, on l'annule.
#  Le feu venu d'ailleurs (lave, feu de camp, pieges incendiaires) fonctionne comme avant.
#  Limite : une fleche enflammee ou une epee Fire Aspect n'enflamme pas un zombie en plein jour a ciel ouvert.
#  Pour remettre le soleil dangereux : zombies_sans_brulure: false
# =====================================================================

options:
    zombies_sans_brulure: true

function za_jour(w: world) :: boolean:
    # la nuit va de 18 h 30 à 5 h : c'est un OU, pas un ET (audit M3)
    set {_t} to time in {_w}
    if any:
        {_t} is greater than 18:30
        {_t} is less than 5:00
    then:
        return false
    return true

on combust:
    if {@zombies_sans_brulure} is true:
        if event-entity is a monster:
            if za_jour(world of event-entity) is true:
                set {_l} to location of event-entity
                set {_b} to "%block at {_l}%"
                if any:
                    {_b} contains "lava"
                    {_b} contains "fire"
                then:
                    stop
                if y-coordinate of {_l} < y-coordinate of (location of (highest block at {_l})):
                    stop
                cancel the event
