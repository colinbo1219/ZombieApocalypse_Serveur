function za_ruines_panneau(n: text) :: text:
    if {_n} is "cafe":
        return "52;66;44"
    if {_n} is "archives":
        return "136;75;24"
    if {_n} is "lefort":
        return "98;75;24"
    if {_n} is "norda":
        return "112;76;51"
    if {_n} is "labo":
        return "103;76;27"
    if {_n} is "chambre104":
        return "136;65;24"
    return ""

