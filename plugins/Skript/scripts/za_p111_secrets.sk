# za_p111_secrets.sk — ce que le monde cache (bible v2, points 67, 71, 88, 95, 110 ; chaîne 8)
#  * INFECTION CACHÉE (110) : un survivant de la base a été mordu et le tait. Le moteur (Mensonges) écrit des indices
#    dans le journal de base pendant 2-3 jours, puis il bascule, la nuit, quand le propriétaire est là (zaevt pnj_bascule).
#    Menu du survivant : « Faire un test » (Kit de depistage, ou sans kit dans un labo : fiable) et « Lui donner un
#    Sérum » (sauve un infecté avant la bascule). Le chien de la base grogne contre lui.
#  * REFUGES TROP UTILISÉS (67) : dormir souvent au même abri improvisé laisse une odeur. Griffures (refuge_signe),
#    puis une embuscade (refuge_embuscade).
#  * RÉPUTATION DE PROIE (71) : /proie, ce que les morts retiennent de toi ({za::mot::proie::<uuid>}).
#  * DÉSERTEURS DE BRAVO (88) : un camp d'anciens soldats près de la station-service est. NORDA les traque ; quand
#    elle s'approche (zaevt deserteurs_menaces), les joueurs choisissent : /deserteurs proteger|livrer.
#  Variables : {za::sec::bravo::*}

# ---------------------------------------------------------------- ordres du moteur

function za_sec_evt(t: text, ligne: text):
    set {_a::*} to split {_ligne} at " "
    if {_t} is "pnj_bascule":
        za_sec_bascule({_a::2}, {_a::3} parsed as number)
    else if {_t} is "refuge_signe":
        set {_p} to za_mot_joueur({_a::2})
        if {_p} is set:
            if za_pro({_p}) is false:
                send "&8Des griffures fraîches sur le cadre de la porte. Quelque chose est venu renifler ici. &7(trop souvent le même abri)" to {_p}
                play sound "block.wood.hit" with volume 0.8 and pitch 0.6 at {_p}
    else if {_t} is "refuge_embuscade":
        set {_p} to za_mot_joueur({_a::2})
        if {_p} is set:
            if za_pro({_p}) is false:
                send "&4Ils connaissent cet endroit. &cDes pas traînants, de tous les côtés à la fois." to {_p}
                za_spawn_near({_p}, "ZA_Shambler", 10, 16)
                za_spawn_near({_p}, "ZA_Shambler", 10, 16)
                if chance of 50%:
                    za_spawn_near({_p}, "ZA_Runner", 14, 20)
    else if {_t} is "deserteurs_menaces":
        za_sec_bravo_menace()

# la bascule : le survivant meurt, un mort se relève à sa place
function za_sec_bascule(u: text, id: number):
    if {za::surv::%{_id}%::etat} is not set:
        stop
    set {_nom} to {za::surv::%{_id}%::nom}
    set {_l} to {za::surv::%{_id}%::lieu}
    set {_e} to za_surv_npc({_id})
    if {_e} is set:
        set {_l} to location of {_e}
    loop {za::surv::liste::*}:
        set {_o} to loop-value
        if {za::surv::%{_o}%::base} is {_u}:
            if {_o} is not {_id}:
                za_surv_moral_ajouter({_o}, -12)
    add "%{_nom}% (jour %{za::serveur::jours}%, infecté)" to {za::surv::morts::*}
    delete {za::mot::infecte::%{_id}%}
    za_surv_clore({_id}, "zombifie")
    za_surv_avis({_u}, "&4&l† &c%{_nom}% s'est mis à hurler dans la nuit. &4Ce n'est plus lui. &7La morsure, cachée sous le bandage...")
    za_journal("%{_nom}% s'est transformé à l'intérieur d'une base.")
    if {_l} is set:
        set {_wd} to za_dim(world of {_l})
        execute console command "execute in %{_wd}% run summon zombie_villager %x-coordinate of {_l}% %y-coordinate of {_l}% %z-coordinate of {_l}% {CustomName:'""%{_nom}%""',CustomNameVisible:1b,PersistenceRequired:1b,Attributes:[{Name:""generic.max_health"",Base:26},{Name:""generic.attack_damage"",Base:5}],Health:26f}"
        play sound "entity.zombie_villager.converted" with volume 2 at {_l}

# ---------------------------------------------------------------- menu du survivant (za_p43)

# « Faire un test » : au labo, l'analyse de sang est fiable ; sur le terrain, il faut un kit
function za_sec_tester(p: player, id: number):
    set {_labo} to 0
    if za_sci_labo({_p}) is true:
        set {_labo} to 1
    else if za_take_named({_p}, "Kit de depistage", 1) is false:
        send "&7Il te faut un &eKit de depistage &7(médecin) ou un laboratoire équipé." to {_p}
        stop
    if za_mot_actif() is false:
        send "&7Le test est négatif. &8(un kit de terrain peut se tromper)" to {_p}
        stop
    send "&8Il tend le bras, sans un mot. Tu piques. Tu attends." to {_p}
    za_mot("testpnj %{_p}'s uuid% %{_id}% %{_labo}%")
    za_surv_moral_ajouter({_id}, -3)

function za_sec_serum(p: player, id: number):
    if za_take_named({_p}, "Serum", 1) is false:
        send "&cTu n'as pas de Sérum." to {_p}
        stop
    if za_mot_actif() is false:
        send "&7Il range le Sérum. « Merci. Je le garde pour quelqu'un qui en aura besoin. »" to {_p}
        stop
    za_mot("soignerpnj %{_p}'s uuid% %{_id}%")

# le chien de la base flaire un infecté caché (appelé par za_chien_sentir, p108)
function za_sec_chien(p: player, l: location):
    set {_u} to "%{_p}'s uuid%"
    loop {za::surv::liste::*}:
        set {_o} to loop-value
        if {za::surv::%{_o}%::base} is {_u}:
            if {za::mot::infecte::%{_o}%} is "1":
                set {_e} to za_surv_npc({_o})
                if {_e} is set:
                    if world of {_e} is world of {_l}:
                        if distance between {_e} and {_l} < 10:
                            play sound "entity.wolf.growl" with volume 1 and pitch 0.6 at {_l}
                            if chance of 25%:
                                send "&6[Base] &eLe chien ne lâche pas %{za::surv::%{_o}%::nom}% des yeux. Il grogne, tout bas." to {_p}

# ---------------------------------------------------------------- réputation de proie (71)

command /proie:
    trigger:
        if za_pro(player) is true:
            stop
        set {_k} to ({za::mot::proie::%player's uuid%} ? "0") parsed as number
        if {_k} is not set:
            set {_k} to 0
        if {_k} < 10:
            send "&7Les morts ne te connaissent pas encore. Tu es une odeur parmi d'autres." to player
        else if {_k} < 40:
            send "&eLes morts commencent à te reconnaître. &7Ceux qui t'ont vu tuer les leurs se souviennent de ta silhouette." to player
        else if {_k} < 100:
            send "&6Tu es une proie connue. &7Ils viennent plus vite quand tu fais du bruit, et ils restent plus longtemps." to player
        else:
            send "&cTu es LA proie. &7Les hordes changent de route pour toi. Le Directeur le sait. Fais-toi oublier." to player
        send "&8(%{_k}% mort(s) récent(s) qui te sont attribué(s) ; ça s'efface avec le temps)" to player

# ---------------------------------------------------------------- Déserteurs de Bravo (88)

function za_sec_bravo_pres(p: player) :: boolean:
    if world of {_p} is not world("world"):
        return false
    return sqrt(((x-coordinate of {_p}) - 4050) ^ 2 + ((z-coordinate of {_p}) - 330) ^ 2) < 80

function za_sec_bravo_menace():
    if {za::sec::bravo::sort} is set:
        stop
    set {za::sec::bravo::menace} to unix timestamp of now
    loop za_monde_joueurs():
        if za_pro(loop-value) is false:
            send "&8[Radio] &7Sur le canal de Bravo : une opération contre les déserteurs du secteur est. &e/deserteurs &7pour décider ce que tu fais." to loop-value

command /deserteurs [<text>]:
    aliases: /bravo
    trigger:
        if za_pro(player) is true:
            stop
        if {za::sec::bravo::sort} is set:
            send "&7Les Déserteurs de Bravo : %{za::sec::bravo::sort}%." to player
            stop
        if {za::sec::bravo::menace} is not set:
            send "&7On parle d'anciens soldats de Bravo terrés près de la station-service, à l'est (4050, 330). Ils ne veulent voir personne." to player
            stop
        set {_c} to arg-1 ? ""
        if {_c} is not "proteger" or "livrer":
            send "&6&l━━ DÉSERTEURS DE BRAVO ━━" to player
            send "&7NORDA vient les chercher. Ils sont huit, épuisés, avec des enfants qu'ils ont ramassés en route." to player
            send "&a/deserteurs proteger &7: aller les défendre. NORDA saura que tu les as aidés." to player
            send "&c/deserteurs livrer &7: donner leur position. NORDA oubliera un peu ton dossier. D'autres, non." to player
            stop
        if za_sec_bravo_pres(player) is false:
            if {_c} is "proteger":
                send "&7Pour les protéger, il faut être avec eux (4050, 330)." to player
                stop
        if {_c} is "proteger":
            set {za::sec::bravo::sort} to "protégés par %player%"
            za_cmpg_decision("%player's uuid%", "Tu as protégé les Déserteurs de Bravo contre NORDA.")
            za_rel_ajouter(player, "vega", 8)
            za_faction_ajouter(player, "survivants", 5)
            za_spawn_near(player, "ZA_Agent_NORDA", 18, 26)
            za_spawn_near(player, "ZA_Agent_NORDA", 18, 26)
            send "&aLe sergent te serre la main. &f« On s'en souviendra. » &7Des phares blancs, au loin : ils arrivent." to player
        else:
            set {za::sec::bravo::sort} to "livrés à NORDA"
            za_cmpg_decision("%player's uuid%", "Tu as livré les Déserteurs de Bravo à NORDA.")
            za_rel_ajouter(player, "vega", -12)
            za_faction_ajouter(player, "survivants", -5)
            za_jetons_ajouter(player, 25)
            send "&8Tu donnes la position sur la fréquence de Bravo. Une voix neutre : « Reçu. » &7(+25 jetons, versés plus tard par un inconnu)" to player
        if za_mot_actif() is true:
            za_mot("deserteurs %{_c}% %player's uuid%")
