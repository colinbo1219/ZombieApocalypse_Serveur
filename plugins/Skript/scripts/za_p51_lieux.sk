# =====================================================================
#  ZombieApocalypse - MÉCANIQUES PAR LIEU : chaque bâtiment (za_p35) a sa propre raison d'être
#  Le joueur entre à moins de 12 blocs : barre d'action (une fois par visite) + le bâtiment est équipé la première fois
#  (blocs interactifs ajoutés : armoire, cellule, réserve, casiers...). État quotidien par bâtiment ({za::lieu::<bâtiment>::...}).
#   - Hôpital  : Dossiers médicaux (lutrin), Poste de soins (alambic, courant du quartier hospitalier requis), patients infectés
#   - Police   : Armoire à armes (Clé de l'armurerie), casiers, Dossiers de police, cellule avec un prisonnier
#   - École    : pupitres (notes, dessins d'enfants), tableau, cafétéria qui se regarnit
#   - Labo     : paillasses/cuves (Échantillon viral, Sang infecte), terminal d'expériences (risque + Matériau expérimental)
#   - Super    : rayons (denrées, certaines avariées), chariots, Réserve à forcer avec un Pied-de-biche (bruit)
#   - Station  : pompes + Jerrican -> Essence (carburant), 3 fois / jour / station
#   - Caserne  : caisses militaires (munitions, armures, arme rare) gardées par des soldats infectés
#   - Centrale : turbines (voir /reseau)
#  /lieux : à quoi sert chaque lieu.   Admin : /zalieu <liste|equiper|restock|proche|role>
#  Objets créés ici : "Clé de l'armurerie" (tripwire hook), "Pied-de-biche" (lingot de fer), "Jerrican" (seau).
#  Dépendances souples (consoles) : zaarme donner <joueur> <gunid> <origine>, zasurv creer <x> <y> <z> <monde> prisonnier, zablessure soigner <joueur>
# =====================================================================

# ---------------------------------------------------------------- outils de géométrie

# identifiant stable d'un bâtiment : la chaîne "bx_gy_bz_monde" de za_p35 (les index de liste peuvent bouger)
function za_lieu_sid(cle: text) :: text:
    set {_k::*} to split {_cle} at ";"
    set {_s} to {za::bat::%{_k::1}%::liste::%{_k::2}%}
    if {_s} is not set:
        return ""
    return "%{_s}%"

function za_lieu_type(cle: text) :: text:
    set {_k::*} to split {_cle} at ";"
    return {_k::1}

# coin d'origine (bx, gy, bz) du bâtiment
function za_lieu_orig(s: text) :: location:
    set {_a::*} to split {_s} at "_"
    set {_wn} to {_a::4}
    set {_i} to 5
    while {_a::%{_i}%} is set:
        set {_wn} to "%{_wn}%_%{_a::%{_i}%}%"
        add 1 to {_i}
    set {_w} to world({_wn})
    if {_w} is not set:
        stop
    return location(({_a::1} parsed as number), ({_a::2} parsed as number), ({_a::3} parsed as number), {_w})

function za_lieu_loc(o: location, dx: number, dy: number, dz: number) :: location:
    return location(((x-coordinate of {_o}) + {_dx}), ((y-coordinate of {_o}) + {_dy}), ((z-coordinate of {_o}) + {_dz}), (world of {_o}))

function za_lieu_set(o: location, dx: number, dy: number, dz: number, b: text):
    set {_wd} to za_dim(world of {_o})
    set {_x} to floor((x-coordinate of {_o}) + {_dx})
    set {_y} to floor((y-coordinate of {_o}) + {_dy})
    set {_z} to floor((z-coordinate of {_o}) + {_dz})
    execute console command "execute in %{_wd}% run setblock %{_x}% %{_y}% %{_z}% %{_b}%"

function za_lieu_fill(o: location, x1: number, y1: number, z1: number, x2: number, y2: number, z2: number, b: text):
    set {_wd} to za_dim(world of {_o})
    set {_bx} to floor(x-coordinate of {_o})
    set {_by} to floor(y-coordinate of {_o})
    set {_bz} to floor(z-coordinate of {_o})
    execute console command "execute in %{_wd}% run fill %{_bx} + {_x1}% %{_by} + {_y1}% %{_bz} + {_z1}% %{_bx} + {_x2}% %{_by} + {_y2}% %{_bz} + {_z2}% %{_b}%"

# toutes les clés "type;index" des bâtiments connus
function za_lieu_toutes() :: texts:
    set {_types::*} to za_bat_types()
    loop {_types::*}:
        set {_t} to loop-value-1
        loop indices of {za::bat::%{_t}%::liste::*}:
            add "%{_t}%;%loop-value-2%" to {_r::*}
    return {_r::*}

# bâtiment le plus proche (centre) dans le rayon, "" sinon (remplace za_bat_proche du noyau)
function za_lieu_proche(l: location, r: number) :: text:
    set {_best} to {_r}
    set {_res} to ""
    set {_all::*} to za_lieu_toutes()
    loop {_all::*}:
        set {_c} to za_bat_centre(loop-value)
        if {_c} is set:
            if world of {_c} is world of {_l}:
                set {_d} to distance between {_c} and {_l}
                if {_d} < {_best}:
                    set {_best} to {_d}
                    set {_res} to loop-value
    return {_res}

# bâtiment dont l'emprise (annexes comprises) contient ce bloc, "" sinon
function za_lieu_at(l: location) :: text:
    set {_all::*} to za_lieu_toutes()
    loop {_all::*}:
        set {_o} to za_lieu_orig(za_lieu_sid(loop-value))
        if {_o} is set:
            if world of {_o} is world of {_l}:
                set {_dx} to floor(x-coordinate of {_l}) - (x-coordinate of {_o})
                set {_dy} to floor(y-coordinate of {_l}) - (y-coordinate of {_o})
                set {_dz} to floor(z-coordinate of {_l}) - (z-coordinate of {_o})
                if all:
                    {_dx} >= -3
                    {_dx} <= 20
                    {_dz} >= -2
                    {_dz} <= 9
                    {_dy} >= -1
                    {_dy} <= 9
                then:
                    return loop-value
    return ""

# rôle d'un bloc selon le type du bâtiment et sa position relative
function za_lieu_role(t: text, dx: number, dy: number, dz: number) :: text:
    if {_t} is "hopital":
        if all:
            {_dx} is 2
            {_dy} is 1
            {_dz} is 1
        then:
            return "dossiers"
        if all:
            {_dy} is 1
            {_dx} is 5
            {_dz} is 1
        then:
            return "soins"
        if all:
            {_dy} is 1
            {_dx} is 7
            {_dz} is 6
        then:
            return "soins"
    else if {_t} is "police":
        if all:
            {_dx} is 1
            {_dy} is 1
            {_dz} is 5
        then:
            return "dossiers"
        if all:
            {_dx} is 9
            {_dy} is 1
            {_dz} is 2
        then:
            return "armoire"
        if all:
            {_dy} is 1
            {_dx} is 1 or 2
            {_dz} is 6
        then:
            return "casier"
        if all:
            {_dx} is 5
            {_dz} is 1
            {_dy} is 1 or 2
        then:
            return "cellule"
    else if {_t} is "labo2":
        if all:
            {_dx} is 1
            {_dy} is 1
            {_dz} is 4
        then:
            return "terminal"
        if all:
            {_dx} is 6
            {_dy} is 1
        then:
            return "paillasse"
        if all:
            {_dx} is 8
            {_dy} is 1
        then:
            return "cuve"
    else if {_t} is "super":
        if all:
            {_dx} is 2 or 6 or 10
            {_dy} is 1 or 2
            {_dz} >= 1
            {_dz} <= 6
        then:
            return "rayon"
        if all:
            {_dx} is 13
            {_dz} is 3
            {_dy} is 1 or 2
        then:
            return "reserve"
    else if {_t} is "station":
        if all:
            {_dx} is -2
            {_dy} >= 1
            {_dy} <= 3
            {_dz} is 2 or 4
        then:
            return "pompe"
    else if {_t} is "caserne":
        if all:
            {_dy} is 1
            {_dz} is 1
            {_dx} is 7 or 9 or 11
        then:
            return "caisse"
    else if {_t} is "ecole":
        if all:
            {_dx} is 1 or 4
            {_dy} is 1
            {_dz} >= 1
            {_dz} <= 4
        then:
            return "pupitre"
        if all:
            {_dx} >= 1
            {_dx} <= 4
            {_dy} >= 1
            {_dy} <= 2
            {_dz} is 6
        then:
            return "tableau"
    else if {_t} is "centrale":
        if all:
            {_dy} is 1
            {_dz} is 5
            {_dx} is 2 or 5 or 8
        then:
            return "turbine"
    return ""

function za_lieu_role_l(cle: text, l: location) :: text:
    set {_o} to za_lieu_orig(za_lieu_sid({_cle}))
    if {_o} is not set:
        return ""
    if world of {_o} is not world of {_l}:
        return ""
    set {_dx} to floor(x-coordinate of {_l}) - (x-coordinate of {_o})
    set {_dy} to floor(y-coordinate of {_l}) - (y-coordinate of {_o})
    set {_dz} to floor(z-coordinate of {_l}) - (z-coordinate of {_o})
    return za_lieu_role(za_lieu_type({_cle}), {_dx}, {_dy}, {_dz})

# délai par joueur et par action : vrai si l'action est permise (et lance le délai)
function za_lieu_cd(p: player, k: text, secs: number) :: boolean:
    set {_u} to {_p}'s uuid
    if {za::lieu::cd::%{_u}%::%{_k}%} is set:
        if now < {za::lieu::cd::%{_u}%::%{_k}%}:
            return false
    set {za::lieu::cd::%{_u}%::%{_k}%} to now
    add ("%{_secs}% seconds" parsed as timespan) to {za::lieu::cd::%{_u}%::%{_k}%}
    return true

function za_nb_armes(p: player) :: number:
    set {_n} to 0
    loop all items in inventory of {_p}:
        if "%type of loop-item%" contains "modern_kinetic_gun":
            add item amount of loop-item to {_n}
    return {_n}

# donne une arme de collection (module armes) ; si la commande n'existe pas ou échoue, arme TaCZ standard en secours
function za_lieu_arme(p: player, gun: text, origine: text, munition: text, qte: number):
    set {_avant} to za_nb_armes({_p})
    execute console command "zaarme donner %{_p}% %{_gun}% %{_origine}%"
    wait 4 ticks
    if za_nb_armes({_p}) <= {_avant}:
        execute console command "give %{_p}% tacz:modern_kinetic_gun{GunId:""tacz:%{_gun}%"",GunFireMode:""SEMI"",GunCurrentAmmoCount:0} 1"
    if {_munition} is not "":
        execute console command "give %{_p}% tacz:ammo{AmmoId:""tacz:%{_munition}%""} %{_qte}%"

function za_lieu_nom_court(t: text) :: text:
    return za_bat_nom({_t})

# ---------------------------------------------------------------- équipement d'un bâtiment (première visite)

function za_lieu_equiper(cle: text):
    set {_sid} to za_lieu_sid({_cle})
    if {_sid} is "":
        stop
    if {za::lieu::%{_sid}%::equipe} is set:
        stop
    set {_o} to za_lieu_orig({_sid})
    if {_o} is not set:
        stop
    set {za::lieu::%{_sid}%::equipe} to {za::serveur::jours}
    set {_t} to za_lieu_type({_cle})
    set {_w} to world of {_o}
    if {_t} is "hopital":
        za_lieu_set({_o}, 2, 1, 1, "minecraft:lectern[facing=south]")
        za_lieu_set({_o}, 5, 1, 1, "minecraft:brewing_stand")
        za_lieu_set({_o}, 5, 1, 2, "minecraft:oak_sign[rotation=8]")
        wait 2 ticks
        set {_s} to block at za_lieu_loc({_o}, 5, 1, 2)
        set line 1 of {_s} to "&2Poste de soins"
        set line 2 of {_s} to "&85 jetons"
        set line 3 of {_s} to "&8Soins complets"
        set line 4 of {_s} to "&cCourant requis"
    else if {_t} is "police":
        za_lieu_set({_o}, 1, 1, 5, "minecraft:lectern[facing=east]")
        za_lieu_set({_o}, 1, 1, 6, "minecraft:barrel[facing=up]")
        za_lieu_set({_o}, 2, 1, 6, "minecraft:barrel[facing=up]")
        za_lieu_set({_o}, 9, 1, 2, "minecraft:chest[facing=west]")
        # la cellule : on ouvre la cage (2 blocs de haut) derrière la porte de fer
        za_lieu_fill({_o}, 5, 1, 2, 5, 2, 5, "minecraft:air")
        za_lieu_set({_o}, 5, 1, 3, "minecraft:oak_sign[rotation=8]")
        wait 2 ticks
        set {_s} to block at za_lieu_loc({_o}, 5, 1, 3)
        set line 1 of {_s} to "&8Cellule 1"
        set line 2 of {_s} to "&8(verrouillée)"
    else if {_t} is "super":
        # annexe "Réserve" derrière une porte de fer (pied-de-biche)
        za_lieu_fill({_o}, 15, 1, 0, 19, 5, 8, "minecraft:air")
        za_lieu_fill({_o}, 15, 0, 0, 19, 0, 8, "minecraft:light_gray_concrete")
        za_lieu_fill({_o}, 15, 1, 0, 19, 3, 0, "minecraft:light_gray_concrete")
        za_lieu_fill({_o}, 15, 1, 8, 19, 3, 8, "minecraft:light_gray_concrete")
        za_lieu_fill({_o}, 19, 1, 1, 19, 3, 7, "minecraft:light_gray_concrete")
        za_lieu_fill({_o}, 15, 4, 0, 19, 5, 8, "minecraft:light_gray_concrete")
        za_lieu_set({_o}, 17, 4, 4, "minecraft:sea_lantern")
        za_lieu_set({_o}, 18, 1, 1, "minecraft:barrel[facing=up]")
        za_lieu_set({_o}, 18, 1, 3, "minecraft:barrel[facing=up]")
        za_lieu_set({_o}, 18, 1, 5, "minecraft:barrel[facing=up]")
        za_lieu_set({_o}, 18, 1, 7, "minecraft:barrel[facing=up]")
        za_lieu_fill({_o}, 16, 1, 7, 17, 2, 7, "minecraft:bookshelf")
        za_lieu_fill({_o}, 13, 1, 3, 14, 2, 3, "minecraft:air")
        za_lieu_fill({_o}, 13, 1, 3, 13, 1, 3, "minecraft:iron_door[facing=east,half=lower]")
        za_lieu_fill({_o}, 13, 2, 3, 13, 2, 3, "minecraft:iron_door[facing=east,half=upper]")
        za_lieu_set({_o}, 12, 2, 2, "minecraft:oak_wall_sign[facing=west]")
        # chariots abandonnés
        za_lieu_set({_o}, 4, 1, 3, "minecraft:hopper[facing=down]")
        za_lieu_set({_o}, 4, 2, 3, "minecraft:iron_bars")
        za_lieu_set({_o}, 8, 1, 5, "minecraft:hopper[facing=down]")
        za_lieu_set({_o}, 8, 2, 5, "minecraft:iron_bars")
        za_lieu_set({_o}, 12, 1, 5, "minecraft:iron_trapdoor[facing=north,half=bottom,open=false]")
        wait 2 ticks
        set {_s} to block at za_lieu_loc({_o}, 12, 2, 2)
        set line 1 of {_s} to "&8RÉSERVE"
        set line 2 of {_s} to "&7Personnel seulement"
        set line 3 of {_s} to "&8(porte verrouillée)"
    else if {_t} is "station":
        za_lieu_set({_o}, -1, 1, 3, "minecraft:oak_sign[rotation=4]")
        wait 2 ticks
        set {_s} to block at za_lieu_loc({_o}, -1, 1, 3)
        set line 1 of {_s} to "&cPOMPES"
        set line 2 of {_s} to "&7Jerrican requis"
        set line 3 of {_s} to "&8Ne pas fumer"
        set {_c} to block at za_lieu_loc({_o}, 6, 1, 5)
        if {_c} is chest:
            if chance of 55%:
                add za_item("bucket", "Jerrican", "&e", 1) to inventory of {_c}
            if chance of 40%:
                add za_item("iron ingot", "Pied-de-biche", "&7", 1) to inventory of {_c}
    else if {_t} is "labo2":
        za_lieu_set({_o}, 1, 1, 4, "minecraft:lectern[facing=east]")
    else if {_t} is "caserne":
        za_lieu_set({_o}, 7, 1, 1, "minecraft:barrel[facing=up]")
        za_lieu_set({_o}, 9, 1, 1, "minecraft:barrel[facing=up]")
        za_lieu_set({_o}, 11, 1, 1, "minecraft:barrel[facing=up]")
        execute console command "mm mobs spawn ZA_Soldat_Infecte 1 %{_w}%,%floor(x-coordinate of {_o}) + 8%,%floor(y-coordinate of {_o}) + 1%,%floor(z-coordinate of {_o}) + 4%"
        execute console command "mm mobs spawn ZA_Soldat_Infecte 1 %{_w}%,%floor(x-coordinate of {_o}) + 10%,%floor(y-coordinate of {_o}) + 1%,%floor(z-coordinate of {_o}) + 3%"
    else if {_t} is "ecole":
        za_lieu_set({_o}, 9, 1, 5, "minecraft:barrel[facing=up]")
        za_lieu_set({_o}, 9, 1, 6, "minecraft:barrel[facing=up]")
    else if {_t} is "centrale":
        za_lieu_set({_o}, 5, 1, 7, "minecraft:lectern[facing=north]")

# ---------------------------------------------------------------- remise en état quotidienne (paresseuse, à l'arrivée d'un joueur)

function za_lieu_restock(cle: text):
    set {_sid} to za_lieu_sid({_cle})
    if {_sid} is "":
        stop
    set {_o} to za_lieu_orig({_sid})
    if {_o} is not set:
        stop
    set {_t} to za_lieu_type({_cle})
    set {_j} to {za::serveur::jours}
    if {_t} is "ecole":
        if {za::lieu::%{_sid}%::cafet} is not {_j}:
            set {za::lieu::%{_sid}%::cafet} to {_j}
            set {_n} to random integer between 1 and 3
            if za_reseau_actif("residentiel") is true:
                add 2 to {_n}
            loop 2 times:
                set {_b} to block at za_lieu_loc({_o}, 9, 1, 4 + loop-number)
                if {_b} is barrel:
                    if size of (all items in inventory of {_b}) < 4:
                        add za_item("bread", "Conserve", "&f", {_n}) to inventory of {_b}
    else if {_t} is "hopital":
        if za_reseau_actif("hopital") is true:
            if {za::lieu::%{_sid}%::pharma} is not {_j}:
                set {za::lieu::%{_sid}%::pharma} to {_j}
                set {_b} to block at za_lieu_loc({_o}, 10, 1, 6)
                if {_b} is chest:
                    if chance of 60%:
                        add za_item("paper", "Bandage", "&f", random integer between 1 and 3) to inventory of {_b}
    else if {_t} is "super":
        # la réserve se referme au bout de 6 jours de serveur
        if {za::lieu::%{_sid}%::reserve} is set:
            if {_j} - {za::lieu::%{_sid}%::reserve} >= 6:
                delete {za::lieu::%{_sid}%::reserve}
                za_lieu_fill({_o}, 13, 1, 3, 13, 1, 3, "minecraft:iron_door[facing=east,half=lower]")
                za_lieu_fill({_o}, 13, 2, 3, 13, 2, 3, "minecraft:iron_door[facing=east,half=upper]")
    else if {_t} is "police":
        if za_reseau_actif("police") is true:
            # courant : l'armoire est regarnie chaque jour
            if {za::lieu::%{_sid}%::armoire} is set:
                if {za::lieu::%{_sid}%::armoire} is not {_j}:
                    delete {za::lieu::%{_sid}%::armoire}

# ---------------------------------------------------------------- arrivée dans un bâtiment (barre d'action, équipement, ambiance)

function za_lieu_barre(t: text) :: text:
    if {_t} is "hopital":
        return "&f[Hôpital] &7Médicaments · Soins · Dossiers médicaux"
    if {_t} is "police":
        return "&9[Poste de police] &7Armoire à armes · Casiers · Cellules · Dossiers"
    if {_t} is "super":
        return "&e[Supermarché] &7Rayons · Réserve (pied-de-biche) · Chariots"
    if {_t} is "station":
        return "&c[Station-service] &7Pompes · Jerrican · Essence"
    if {_t} is "labo2":
        return "&a[Laboratoire] &7Échantillons · Expériences · Terminal"
    if {_t} is "caserne":
        return "&2[Caserne] &7Caisses militaires · Gardes infectés · Danger"
    if {_t} is "ecole":
        return "&6[École] &7Pupitres · Tableau · Cafétéria · Dessins"
    if {_t} is "centrale":
        return "&6[Centrale] &7Turbines · Tableau de commande · /reseau"
    return ""

function za_lieu_arrivee(p: player, cle: text):
    set {_t} to za_lieu_type({_cle})
    set {_sid} to za_lieu_sid({_cle})
    set {_u} to {_p}'s uuid
    za_lieu_equiper({_cle})
    za_lieu_restock({_cle})
    set {_b} to za_lieu_barre({_t})
    set {_q} to za_reseau_quartier_de({_t})
    if {_q} is not "":
        if za_reseau_actif({_q}) is true:
            set {_b} to "%{_b}% &a⚡"
    send action bar {_b} to {_p}
    if {za::lieu::vu::%{_u}%::%{_sid}%} is not set:
        set {za::lieu::vu::%{_u}%::%{_sid}%} to true
        add {_sid} to {za::lieu::vus::%{_u}%::*}
        send "&8[Lieu] &7Tu découvres : &f%za_bat_nom({_t})%&7. &8(/lieux : à quoi ça sert)" to {_p}
    # les patients d'un hôpital qui a du courant se réveillent
    if {_t} is "hopital":
        if za_reseau_actif("hopital") is true:
            if chance of 45%:
                set {_c} to za_bat_centre({_cle})
                if {_c} is set:
                    send "&8*bip... bip...* Les machines de l'hôpital se sont rallumées. Quelque chose bouge dans les chambres." to {_p}
                    za_spawn_at({_c}, "ZA_Patient_Infecte", 4, 9)
    if {_t} is "centrale":
        if za_courant() is true:
            send "&6[Centrale] &7Les turbines tournent encore. &e/reseau &7pour répartir le courant." to {_p}
        else:
            send "&6[Centrale] &7Silence. Les turbines sont froides. &83 Composants électroniques au lutrin les relancent." to {_p}

function za_lieu_scan(p: player):
    set {_u} to {_p}'s uuid
    set {_cle} to za_lieu_proche(location of {_p}, 12)
    set {_dans} to {za::lieu::dans::%{_u}%}
    if {_cle} is "":
        if {_dans} is set:
            if za_lieu_proche(location of {_p}, 20) is "":
                delete {za::lieu::dans::%{_u}%}
        stop
    if {_dans} is {_cle}:
        # présence prolongée : parfois un patient dans un hôpital sous tension
        if za_lieu_type({_cle}) is "hopital":
            if za_reseau_actif("hopital") is true:
                if chance of 2%:
                    set {_c} to za_bat_centre({_cle})
                    if {_c} is set:
                        za_spawn_at({_c}, "ZA_Patient_Infecte", 5, 10)
        stop
    set {za::lieu::dans::%{_u}%} to {_cle}
    za_lieu_arrivee({_p}, {_cle})

every 4 seconds:
    loop za_monde_joueurs():
        za_lieu_scan(loop-player)

# ---------------------------------------------------------------- clic droit : dispatch selon le rôle du bloc

function za_lieu_clic(p: player, l: location, bt: text) :: boolean:
    set {_cle} to za_lieu_at({_l})
    if {_cle} is "":
        return false
    set {_r} to za_lieu_role_l({_cle}, {_l})
    if {_r} is "":
        return false
    set {_t} to za_lieu_type({_cle})
    if {_r} is "dossiers":
        if {_t} is "hopital":
            za_lieu_dossiers_hopital({_p}, {_cle})
        else:
            za_lieu_dossiers_police({_p}, {_cle})
    else if {_r} is "soins":
        za_lieu_poste_soins({_p}, {_cle}, {_l})
    else if {_r} is "armoire":
        za_lieu_armoire({_p}, {_cle})
    else if {_r} is "casier":
        za_lieu_casier({_p}, {_cle}, {_l})
    else if {_r} is "cellule":
        za_lieu_cellule({_p}, {_cle})
    else if {_r} is "rayon":
        za_lieu_rayon({_p}, {_cle}, {_l})
    else if {_r} is "reserve":
        za_lieu_reserve({_p}, {_cle})
    else if {_r} is "pompe":
        za_lieu_pompe({_p}, {_cle})
    else if {_r} is "caisse":
        za_lieu_caisse({_p}, {_cle}, {_l})
    else if {_r} is "pupitre":
        za_lieu_pupitre({_p}, {_cle}, {_l})
    else if {_r} is "tableau":
        za_lieu_tableau({_p}, {_cle})
    else if {_r} is "terminal":
        za_lieu_terminal({_p}, {_cle})
    else if {_r} is "paillasse":
        za_lieu_prelevement({_p}, {_cle}, {_l}, "paill")
    else if {_r} is "cuve":
        za_lieu_prelevement({_p}, {_cle}, {_l}, "cuve")
    else if {_r} is "turbine":
        za_lieu_turbine({_p})
    else:
        return false
    return true

on right click on lectern:
    if za_pro(player) is true:
        stop
    if za_lieu_clic(player, location of event-block, "lectern") is true:
        cancel the event

