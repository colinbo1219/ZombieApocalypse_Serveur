# zones vivantes (p97) des quartiers des villes
function za_villes_quartiers() :: texts:
    add "v_laurentia_centre0" to {_r::*}
    add "v_laurentia_affaires1" to {_r::*}
    add "v_laurentia_civique2" to {_r::*}
    add "v_laurentia_commercial3" to {_r::*}
