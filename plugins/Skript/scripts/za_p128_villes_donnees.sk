        return "68;0"
    if {_z} is "v_laurentia_riche7":
        return "15;60"
    if {_z} is "v_laurentia_pauvre8":
        return "78;0"
    if {_z} is "v_laurentia_industriel9":
        return "68;0"
    if {_z} is "v_saint_remi_centre0":
        return "70;35"
    if {_z} is "v_saint_remi_industriel1":
        return "15;60"
    if {_z} is "v_saint_remi_industriel2":
        return "78;0"
    if {_z} is "v_saint_remi_gare3":
        return "35;45"
    if {_z} is "v_saint_remi_pauvre4":
        return "78;0"
    if {_z} is "v_saint_remi_pauvre5":
        return "68;0"
    if {_z} is "v_saint_remi_commercial6":
        return "55;0"
    if {_z} is "v_sainte_agathe_centre0":
