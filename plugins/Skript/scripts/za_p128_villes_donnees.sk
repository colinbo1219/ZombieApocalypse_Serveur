    add "v_laurentia_pauvre8" to {_r::*}
    add "v_laurentia_industriel9" to {_r::*}
    add "v_saint_remi_centre0" to {_r::*}
    add "v_saint_remi_industriel1" to {_r::*}
    add "v_saint_remi_industriel2" to {_r::*}
    add "v_saint_remi_gare3" to {_r::*}
    add "v_saint_remi_pauvre4" to {_r::*}
    add "v_saint_remi_pauvre5" to {_r::*}
    add "v_saint_remi_commercial6" to {_r::*}
    add "v_sainte_agathe_centre0" to {_r::*}
    add "v_sainte_agathe_banlieue1" to {_r::*}
    add "v_sainte_agathe_banlieue2" to {_r::*}
    add "v_sainte_agathe_riche3" to {_r::*}
    add "v_sainte_agathe_banlieue4" to {_r::*}
    add "v_sainte_agathe_parc5" to {_r::*}
    return {_r::*}

# "pression;présence" de départ d'un quartier ("" : pas un quartier de ville)
function za_villes_debut(z: text) :: text:
    if {_z} is "v_laurentia_centre0":
        return "78;0"
    if {_z} is "v_laurentia_affaires1":
        return "70;35"
    if {_z} is "v_laurentia_civique2":
        return "35;45"
    if {_z} is "v_laurentia_commercial3":
        return "55;0"
    if {_z} is "v_laurentia_residentiel4":
        return "22;0"
    if {_z} is "v_laurentia_residentiel5":
        return "45;0"
