    if {_z} is "v_sainte_agathe_banlieue1":
        return "22;0"
    if {_z} is "v_sainte_agathe_banlieue2":
        return "45;0"
    if {_z} is "v_sainte_agathe_riche3":
        return "15;60"
    if {_z} is "v_sainte_agathe_banlieue4":
        return "55;0"
    if {_z} is "v_sainte_agathe_parc5":
        return "45;0"
    return ""

